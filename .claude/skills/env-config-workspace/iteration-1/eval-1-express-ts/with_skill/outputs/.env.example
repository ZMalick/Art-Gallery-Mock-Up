# === Database ===
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/myapp_dev

# === Auth ===
# Secret key for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=generate-a-secret-with-openssl-rand-hex-32

# === External Services ===
# Stripe secret key (use test key for development)
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key

# SendGrid API key for transactional emails
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key

# === App ===
# Port the server listens on
PORT=3000

# Environment: development | staging | production
NODE_ENV=development
